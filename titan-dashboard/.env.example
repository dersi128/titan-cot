# Clerk auth
# Publishable (browser / Vite build):
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...   # Development
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...   # Production
#
# Secret (Vercel server-only — NEVER prefix with VITE_):
# Needed only for Production proxy at /__clerk
# CLERK_SECRET_KEY=sk_live_...

# Production (Vercel): NECH PRÁZDNÉ — vercel.json proxy (/api/* → Render).
# NENASTAVUJ VITE_COT_API_URL=https://titan-cot.onrender.com v browser buildu
# (přímé volání Renderu z prohlížeče často padá na CORS / Failed to fetch).

# Jen když běží cot-data-module lokálně:
# VITE_COT_API_URL=http://localhost:3000

# Seasonality: default true = API + Yahoo OHLC.
# VITE_USE_SEASONALITY_API=false
