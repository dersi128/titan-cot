PORT=3000
# Comma-separated frontend URLs (Vercel preview + production)
# CORS_ORIGIN=https://titan-cot.vercel.app,https://titan-cot-xxx.vercel.app
CORS_ORIGIN=

# Cache CFTC responses per symbol (default 15 minutes)
COT_CACHE_TTL_MS=900000

# FRED (St. Louis Fed) — free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Used for Dollar Macro: Fed funds (DFF) + US 2Y yield (DGS2)
FRED_API_KEY=
# Optional cache TTL for FRED (default 6 hours)
# FRED_CACHE_TTL_MS=21600000
