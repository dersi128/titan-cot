# COPY to .env.local ONLY in a separate local/test checkout.
# This file contains placeholders, not credentials. Default: local-only.
TITAN_SYNC_MODE=off
TITAN_STAGING_PROJECT_REF=
TITAN_STAGING_SUPABASE_URL=
TITAN_STAGING_SUPABASE_PUBLISHABLE_KEY=
NEXT_TELEMETRY_DISABLED=1
# Enable only after applying the migration to a separate TEST Supabase project:
# TITAN_SYNC_MODE=staging
# Never use service_role / sb_secret keys here.
