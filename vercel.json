{
  "installCommand": "cd titan-dashboard && npm install",
  "buildCommand": "cd titan-dashboard && npm run build",
  "outputDirectory": "titan-dashboard/dist",
  "framework": "vite",
  "functions": {
    "api/cot/[...path].mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/__clerk",
      "destination": "/api/clerk-proxy"
    },
    {
      "source": "/__clerk/:path*",
      "destination": "/api/clerk-proxy/:path*"
    },
    {
      "source": "/api/cot/:match*",
      "has": [{ "type": "host", "value": "titan-cot.vercel.app" }],
      "destination": "https://titan-cot.onrender.com/api/cot/:match*"
    },
    {
      "source": "/api/cot/:match*",
      "has": [{ "type": "host", "value": "titan-cot-dersisvan-s-projects.vercel.app" }],
      "destination": "https://titan-cot.onrender.com/api/cot/:match*"
    },
    {
      "source": "/health",
      "destination": "https://titan-cot.onrender.com/health"
    },
    {
      "source": "/api/seasonality/:match*",
      "destination": "https://titan-cot.onrender.com/api/seasonality/:match*"
    },
    {
      "source": "/api/macro/:match*",
      "destination": "https://titan-cot.onrender.com/api/macro/:match*"
    },
    {
      "source": "/api/yahoo/:match*",
      "destination": "https://query1.finance.yahoo.com/:match*"
    }
  ]
}
