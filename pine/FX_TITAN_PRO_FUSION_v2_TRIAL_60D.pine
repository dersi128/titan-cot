// =====================================================================
// 7) AI PANEL / FUSION SCORE
// =====================================================================
grp_ai = "AI PANEL / FUSION"
showFusionPanel   = input.bool(true, "Zobrazit Fusion panel", group=grp_ai)
string panelVerdictSize = input.string("Velký", "Velikost VERDIKTU", options=["Normální", "Velký", "Extra velký"], group=grp_ai, tooltip="Horní řádek panelu + velikost ostatních řádků tabulky (HTF, COT, zóna…). Výchozí Velký.")
showSuggestedPath = input.bool(true, "Zobrazit suggested path", group=grp_ai)
fusionWeightTrend = input.float(25, "Vaha trend", minval=0, maxval=100, group=grp_ai)
fusionWeightCOT   = input.float(25, "Vaha COT", minval=0, maxval=100, group=grp_ai)
fusionWeightLoc   = input.float(20, "Vaha location", minval=0, maxval=100, group=grp_ai)
fusionWeightZone  = input.float(20, "Vaha zone quality", minval=0, maxval=100, group=grp_ai)
fusionWeightSeason= input.float(10, "Vaha seasonality", minval=0, maxval=100, group=grp_ai)

// =====================================================================
// HELPER FUNCTIONS
// =====================================================================
f_tf_label() =>
    timeframe.isseconds ? str.tostring(timeframe.multiplier) + "S" :
     timeframe.isminutes ? str.tostring(timeframe.multiplier) + "m" :
     timeframe.isdaily   ? str.tostring(timeframe.multiplier) + "D" :
     timeframe.isweekly  ? str.tostring(timeframe.multiplier) + "W" :
     timeframe.ismonthly ? str.tostring(timeframe.multiplier) + "M" : timeframe.period

f_tf_minutes() =>
    timeframe.isseconds ? timeframe.multiplier / 60.0 :
     timeframe.isminutes ? timeframe.multiplier * 1.0 :
     timeframe.isdaily   ? timeframe.multiplier * 1440.0 :
     timeframe.isweekly  ? timeframe.multiplier * 10080.0 :
     timeframe.ismonthly ? timeframe.multiplier * 43200.0 : na

f_relation_to_weekly() =>
    curr = f_tf_minutes()
    week = 10080.0
    na(curr) ? "Unknown" : curr < week ? "Lower TF" : curr == week ? "Same TF" : "Higher TF"

f_location_swing_len() =>
    int sl = swingLengthManual
    if useAutoLocationSwing
        if timeframe.ismonthly
            sl := 25
        else if timeframe.isweekly
            sl := timeframe.multiplier == 2 ? 125 : timeframe.multiplier == 1 ? 75 : swingLengthManual
        else if timeframe.isdaily
            int dm = timeframe.multiplier
            sl := dm == 3 ? 100 : dm == 2 ? 125 : dm == 1 ? 150 : swingLengthManual
    sl

swingLength = f_location_swing_len()

f_clamp(_x, _min, _max) =>
    math.max(_min, math.min(_x, _max))

f_adx(_len) =>
    upMove    = high - high[1]
    downMove  = low[1] - low
    plusDM    = upMove > downMove and upMove > 0 ? upMove : 0.0
    minusDM   = downMove > upMove and downMove > 0 ? downMove : 0.0
    tr        = ta.tr(true)
    atrRma    = ta.rma(tr, _len)
    rmaPlus   = ta.rma(plusDM, _len)
    rmaMinus  = ta.rma(minusDM, _len)
    plusDI    = atrRma == 0 ? 0.0 : 100.0 * rmaPlus / atrRma
    minusDI   = atrRma == 0 ? 0.0 : 100.0 * rmaMinus / atrRma
    diSum     = plusDI + minusDI
    dx        = diSum == 0 ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / diSum
    ta.rma(dx, _len)

pair_bull(float a, float b, bool onA, bool onB) =>
    not onA or not onB ? true : a > b

pair_bear(float a, float b, bool onA, bool onB) =>
    not onA or not onB ? true : a < b

f_structure_pack(int swingLen) =>
    float ph = ta.pivothigh(high, swingLen, swingLen)
    float pl = ta.pivotlow(low, swingLen, swingLen)
    float lastPH = ta.valuewhen(not na(ph), ph, 0)
    float prevPH = ta.valuewhen(not na(ph), ph, 1)
    float lastPL = ta.valuewhen(not na(pl), pl, 0)
    float prevPL = ta.valuewhen(not na(pl), pl, 1)
    bool hasPH = not na(lastPH) and not na(prevPH)
    bool hasPL = not na(lastPL) and not na(prevPL)
    bool hh = hasPH and lastPH > prevPH
    bool hl = hasPL and lastPL > prevPL
    bool lh = hasPH and lastPH < prevPH
    bool ll = hasPL and lastPL < prevPL
    bool bullFull = hh and hl
    bool bearFull = lh and ll
    bool earlyBull = (hh or hl) and not bullFull and not bearFull
    bool earlyBear = (lh or ll) and not bullFull and not bearFull
    int dir = bullFull ? 1 : bearFull ? -1 : 0
    bool hasPivots = hasPH or hasPL
    [dir, hh, hl, lh, ll, earlyBull, earlyBear, hasPivots]

f_trend_bias_tf_auto() =>
    timeframe.ismonthly ? "" :
     timeframe.isweekly ? "M" :
     timeframe.isdaily ? "W" :
     "D"

f_trend_bias_tf() =>
    trendBiasMode == "Auto" ? f_trend_bias_tf_auto() :
     trendBiasMode == "1D" ? "D" :
     trendBiasMode == "1W" ? "W" : "M"

f_trend_htf_bias_swing(string htfTf) =>
    if trendHtfSwingMode == "Manuál"
        trendHtfSwingManual
    else if trendHtfSwingMode == "Stejná jako graf"
        swingLength
    else
        htfTf == "M" ? 6 :
         htfTf == "W" ? 10 :
         htfTf == "D" ? 30 : trendHtfSwingManual

f_fetch_htf_structure() =>
    string tf = f_trend_bias_tf()
    if not trendBiasOn or tf == ""
        [0, false, false, false, false, false, false, false]
    else
        int sl = f_trend_htf_bias_swing(tf)
        request.security(syminfo.tickerid, tf, f_structure_pack(sl), barmerge.gaps_off, barmerge.lookahead_off)

f_gap_pct(float a, float b, bool onA, bool onB) =>
    onA and onB and close != 0.0 ? math.abs(a - b) / close * 100.0 : 0.0

f_trend_row_color(int sc) =>
    sc <= 30 ? color.rgb(110, 110, 120) : sc <= 60 ? color.rgb(255, 202, 40) : sc <= 80 ? color.rgb(0, 200, 120) : color.rgb(0, 230, 140)

f_pivot_tags(bool hh, bool hl, bool lh, bool ll) =>
    string t = ""
    if hh
        t += "HH "
    if hl
        t += "HL "
    if lh
        t += "LH "
    if ll
        t += "LL"
    t == "" ? "—" : t

f_state_text(_score) =>
    _score >= 80 ? "Strong Uptrend" :
     _score >= 60 ? "Weak Uptrend" :
     _score > 40 ? "Range" :
     _score > 20 ? "Weak Downtrend" : "Strong Downtrend"

f_market_condition(_adx, _score, _compression, _structDir) =>
    _compression ? "Compression" :
     _adx < rangeThreshold ? "Range" :
     (_score >= trendScoreStrong and _structDir != 0) ? "Trending" : "Weak Trending"

f_state_color(_score) =>
    _score >= 80 ? color.rgb(0, 200, 120) :
     _score >= 60 ? color.rgb(40, 160, 90) :
     _score > 40 ? color.rgb(110, 110, 120) :
     _score > 20 ? color.rgb(190, 70, 70) : color.rgb(130, 30, 30)

f_bar_color_struct(int dir) =>
    color bullC = useStrongBarColors ? color.rgb(0, 230, 140) : color.new(color.rgb(0, 230, 140), 15)
    color bearC = useStrongBarColors ? color.rgb(220, 80, 80) : color.new(color.rgb(220, 80, 80), 15)
    dir == 1 ? bullC : dir == -1 ? bearC : na

f_bias_color(_bias) =>
    _bias == "Bullish" ? color.rgb(25, 95, 45) : _bias == "Bearish" ? color.rgb(120, 30, 30) : color.rgb(75, 75, 75)

f_score_to_text(_s) =>
    _s >= 85 ? "EXCELLENT" : _s >= 70 ? "STRONG" : _s >= 55 ? "GOOD" : _s >= 40 ? "MIXED" : "WEAK"

f_score_color(_s) =>
    _s >= 85 ? color.lime : _s >= 70 ? color.rgb(0, 190, 120) : _s >= 55 ? color.orange : _s >= 40 ? color.yellow : color.red

f_dir_chip(int d) =>
    d == 1 ? "▲ BÝČÍ" : d == -1 ? "▼ MEDVĚDÍ" : "◆ RANGE"

f_verdict_color(string head) =>
    str.contains(head, "LONG") or str.contains(head, "BÝČ") ? color.rgb(0, 230, 140) :
     str.contains(head, "SHORT") or str.contains(head, "MEDV") ? color.rgb(255, 82, 82) :
     str.contains(head, "OPATRN") or str.contains(head, "⚠") ? color.rgb(255, 202, 40) :
     color.rgb(160, 165, 180)

f_panel_verdict_sz(string mode) =>
    mode == "Extra velký" ? size.large : mode == "Velký" ? size.normal : size.small

f_panel_verdict_sub_sz(string mode) =>
    mode == "Extra velký" ? size.small : mode == "Velký" ? size.tiny : size.tiny

f_panel_verdict_score_sz(string mode) =>
    mode == "Extra velký" ? size.normal : mode == "Velký" ? size.small : size.tiny

f_panel_table_val_sz(string mode) =>
    mode == "Extra velký" ? size.normal : mode == "Velký" ? size.small : size.tiny

f_panel_table_sub_sz(string mode) =>
    mode == "Extra velký" ? size.small : mode == "Velký" ? size.tiny : size.tiny

