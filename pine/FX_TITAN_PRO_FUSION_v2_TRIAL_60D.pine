grp_trend = "TREND (STRUCTURE)"
trendUseLocSwing      = input.bool(true, "Swing = Location (auto/manual)", group=grp_trend)
trendSwingManual      = input.int(50, "Swing length (manual)", minval=2, maxval=300, group=grp_trend)
trendEma20On          = input.bool(true, "EMA 20", group=grp_trend, inline="e20")
emaFastLen            = input.int(20, "Len", group=grp_trend, inline="e20", minval=1)
