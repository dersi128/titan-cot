topPremiumColor    = input.color(color.rgb(255, 50, 90), "Top Premium color", group=grp_loc)
premiumColor       = input.color(color.rgb(255, 110, 150), "Premium color", group=grp_loc)
midColor           = input.color(color.rgb(180, 180, 190), "Mid color", group=grp_loc)
discountColor      = input.color(color.rgb(0, 190, 255), "Discount color", group=grp_loc)
