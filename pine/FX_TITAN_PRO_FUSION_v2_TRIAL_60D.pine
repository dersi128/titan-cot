f_getBaseName() =>
    string r  = syminfo.root
    string s  = syminfo.ticker
    string bc = syminfo.basecurrency
    string t  = bc
    if r == "GC" or bc == "XAU"
        t := "GOLD"
    else if r == "SI" or bc == "XAG"
        t := "SILVER"
    else if r == "PL"
        t := "PLATINUM"
    else if r == "PA"
        t := "PALLADIUM"
    else if r == "HG"
        t := "COPPER"
    else if r == "CL" or r == "QM" or bc == "WTI"
        t := "CRUDE OIL"
    else if r == "NG"
        t := "NATURAL GAS"
    else if r == "ZC"
        t := "CORN"
    else if r == "ZW"
        t := "WHEAT"
    else if r == "ZS"
        t := "SOYBEANS"
    else if r == "KC"
        t := "COFFEE"
    else if r == "SB"
        t := "SUGAR"
    else if r == "CC"
        t := "COCOA"
    else if r == "CT"
        t := "COTTON"
    else if r == "ES" or s == "ES1!" or s == "US500" or s == "SPX"
        t := "S&P 500"
    else if r == "NQ" or s == "NQ1!" or s == "US100" or s == "NDX"
        t := "NASDAQ"
    else if r == "YM" or s == "YM1!" or s == "US30" or s == "DJI"
        t := "DOW JONES"
    else if r == "RTY" or s == "RTY1!"
        t := "RUSSELL"
    t

// =====================================================================
// COT CORE
// =====================================================================
bool incl = cot_source == "Futures and Options"
string baseName  = f_getBaseName()
string quoteName = syminfo.currency
bool   is_forex  = syminfo.type == "forex" or syminfo.type == "currency"

f_reqW(sym) =>
    request.security(sym, "W", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)

f_fetchWeeklyNet(code, includeOpts) =>
    float netC = na
    float netR = na
    if code != ""
        idCL = LibraryCOT.COTTickerid("Legacy", code, includeOpts, "Commercial Positions", "Long", "All")
        idCS = LibraryCOT.COTTickerid("Legacy", code, includeOpts, "Commercial Positions", "Short", "All")
        idRL = LibraryCOT.COTTickerid("Legacy", code, includeOpts, "Nonreportable Positions", "Long", "All")
        idRS = LibraryCOT.COTTickerid("Legacy", code, includeOpts, "Nonreportable Positions", "Short", "All")
        cL = f_reqW(idCL)
        cS = f_reqW(idCS)
        rL = f_reqW(idRL)
        rS = f_reqW(idRS)
        netC := (na(cL) or na(cS)) ? na : (cL - cS)
        netR := (na(rL) or na(rS)) ? na : (rL - rS)
    [netC, netR]

f_arrHiLoLastN(float[] arr, int n) =>
    int sz = array.size(arr)
    if sz == 0
        [na, na]
    else
        int nn = math.min(n, sz)
        int start = sz - nn
        float hi = array.get(arr, start)
        float lo = array.get(arr, start)
        if nn >= 2
            for i = start + 1 to sz - 1
                float v = array.get(arr, i)
                hi := math.max(hi, v)
                lo := math.min(lo, v)
        [hi, lo]

string bCode = f_getTickerCode(baseName)
string qCode = is_forex ? f_getTickerCode(quoteName) : ""

[bNetCom, bNetRet] = f_fetchWeeklyNet(bCode, incl)

float qNetCom = na
float qNetRet = na
if is_forex
    [tmpCom, tmpRet] = f_fetchWeeklyNet(qCode, incl)
    qNetCom := tmpCom
    qNetRet := tmpRet

bool isNewW = ta.change(time("W")) != 0
int maxLB = math.max(cot_lb_26, cot_lb_52)

var float[] bComArr = array.new_float()
var float[] bRetArr = array.new_float()
var float[] qComArr = array.new_float()
var float[] qRetArr = array.new_float()

if isNewW
    if not na(bNetCom)
        array.push(bComArr, bNetCom)
        if array.size(bComArr) > maxLB
            array.shift(bComArr)
    if not na(bNetRet)
        array.push(bRetArr, bNetRet)
        if array.size(bRetArr) > maxLB
            array.shift(bRetArr)
    if is_forex
        if not na(qNetCom)
            array.push(qComArr, qNetCom)
            if array.size(qComArr) > maxLB
                array.shift(qComArr)
        if not na(qNetRet)
            array.push(qRetArr, qNetRet)
            if array.size(qRetArr) > maxLB
                array.shift(qRetArr)

f_idxFromArr(float netNow, float[] arr, int lb) =>
    [hh, ll] = f_arrHiLoLastN(arr, lb)
    float idx = (not na(netNow) and not na(hh) and (hh - ll) != 0) ? (netNow - ll) / (hh - ll) * 100 : na
    idx

float bComIdx26 = f_idxFromArr(bNetCom, bComArr, cot_lb_26)
float bComIdx52 = f_idxFromArr(bNetCom, bComArr, cot_lb_52)
float bRetIdx26 = f_idxFromArr(bNetRet, bRetArr, cot_lb_26)
float bRetIdx52 = f_idxFromArr(bNetRet, bRetArr, cot_lb_52)

float qComIdx26 = na
float qComIdx52 = na
float qRetIdx26 = na
float qRetIdx52 = na

if is_forex
    qComIdx26 := f_idxFromArr(qNetCom, qComArr, cot_lb_26)
    qComIdx52 := f_idxFromArr(qNetCom, qComArr, cot_lb_52)
    qRetIdx26 := f_idxFromArr(qNetRet, qRetArr, cot_lb_26)
    qRetIdx52 := f_idxFromArr(qNetRet, qRetArr, cot_lb_52)

f_biasCom(float bIdx, float qIdx, bool isFx, string bC, string qC) =>
    float v = na
    if isFx and bC != "" and qC != "" and not na(bIdx) and not na(qIdx)
        v := bIdx - qIdx
    else if bC != "" and not na(bIdx)
        v := bIdx - 50
    v

f_biasRet(float bIdx, float qIdx, bool isFx, string bC, string qC) =>
    float v = na
    if isFx and bC != "" and qC != "" and not na(bIdx) and not na(qIdx)
        v := bIdx - qIdx
    else if bC != "" and not na(bIdx)
        v := bIdx - 50
    v

float comBias26 = f_biasCom(bComIdx26, qComIdx26, is_forex, bCode, qCode)
float comBias52 = f_biasCom(bComIdx52, qComIdx52, is_forex, bCode, qCode)
float retBias26 = f_biasRet(bRetIdx26, qRetIdx26, is_forex, bCode, qCode)
float retBias52 = f_biasRet(bRetIdx52, qRetIdx52, is_forex, bCode, qCode)

string comDir26 = na(comBias26) ? "NA" : (comBias26 > 0 ? "LONG" : "SHORT")
string comDir52 = na(comBias52) ? "NA" : (comBias52 > 0 ? "LONG" : "SHORT")
string retDir26 = na(retBias26) ? "NA" : (retBias26 > 0 ? "LONG" : "SHORT")
string retDir52 = na(retBias52) ? "NA" : (retBias52 > 0 ? "LONG" : "SHORT")

string cotState =
     (comDir26 == comDir52 and comDir26 == "LONG")  ? "TREND LONG" :
     (comDir26 == comDir52 and comDir26 == "SHORT") ? "TREND SHORT" :
     (comDir52 == "LONG"  and comDir26 == "SHORT") ? "DISTRIBUTION" :
     (comDir52 == "SHORT" and comDir26 == "LONG")  ? "ACCUMULATION" :
     "MIXED"

f_getGrade(_isDemand) =>
    if bCode == "" or comDir52 == "NA" or comDir26 == "NA"
        "B"
    else
        string grade = "B"
        bool needLong    = _isDemand
        bool needShort   = not _isDemand
        bool comOK52     = (needLong and comDir52 == "LONG") or (needShort and comDir52 == "SHORT")
        bool comOK26     = (needLong and comDir26 == "LONG") or (needShort and comDir26 == "SHORT")
        bool retailOpp26 = (comDir26 != retDir26)
        if comOK52 and comOK26
            grade := "A"
        if comOK52 and comOK26 and retailOpp26
            grade := "A++"
        grade

// =====================================================================
// ZONES — TITAN S/D CORE v2 (1:1 logika standalone CORE)
// =====================================================================
atr = ta.atr(14)

float body0       = math.abs(close - open)
bool  is_imp_norm = body0 > (atr * impulse_norm)
bool  is_imp_str  = body0 > (atr * impulse_str)

bool up_break = use_wick_break ? high > high[1] : close > high[1]
bool dn_break = use_wick_break ? low  < low[1]  : close < low[1]

bool imp_up = close > open and is_imp_norm and up_break
bool imp_dn = close < open and is_imp_norm and dn_break

float baseBody  = math.abs(close[1] - open[1])
float baseRange = high[1] - low[1]
bool  is_small_body = baseBody <= atr[1] * base_atr_mult
bool  is_doji = baseRange > syminfo.mintick ? (baseBody / baseRange) <= 0.25 : false
bool  is_base  = is_small_body or is_doji

bool base_ok_for_demand = is_base
bool base_ok_for_supply = is_base

bool hasInSeq = bar_index >= (1 + in_min_candles)
float zTopDemand = high[1]
float zBotDemand = low[1]
float zTopSupply = high[1]
float zBotSupply = low[1]

bool cleanInDemand = hasInSeq
for k = 0 to 9
    if k < in_min_candles
        int off = 2 + k
        float bdy = math.abs(close[off] - open[off])
        bool bear = close[off] < open[off]
        bool big  = bdy > atr[off] * in_body_atr_mult
        cleanInDemand := cleanInDemand and (off <= bar_index) and bear and big

bool cleanInSupply = hasInSeq
for k = 0 to 9
    if k < in_min_candles
        int off = 2 + k
        float bdy = math.abs(close[off] - open[off])
        bool bull = close[off] > open[off]
        bool big  = bdy > atr[off] * in_body_atr_mult
        cleanInSupply := cleanInSupply and (off <= bar_index) and bull and big

bool cleanOutDemand = imp_up and low > zTopDemand
bool cleanOutSupply = imp_dn and high < zBotSupply
bool isTopDemand = use_inout_label and cleanInDemand and cleanOutDemand
bool isTopSupply = use_inout_label and cleanInSupply and cleanOutSupply

zoneLocHigh = request.security(syminfo.tickerid, locationTF, ta.highest(high, swingLength), lookahead=barmerge.lookahead_off)
zoneLocLow  = request.security(syminfo.tickerid, locationTF, ta.lowest(low, swingLength), lookahead=barmerge.lookahead_off)
zoneLocValid = show_location and not na(zoneLocHigh) and not na(zoneLocLow) and zoneLocHigh > zoneLocLow

f_zoneLocationPct(_top, _bot) =>
    float zoneMidPrice = (_top + _bot) * 0.5
    zoneLocValid ? ((zoneMidPrice - zoneLocLow) / (zoneLocHigh - zoneLocLow)) * 100.0 : na

f_zf_strong_uptrend() =>
    float eFast = ta.ema(close, emaFastLen)
    float eMid  = ta.ema(close, emaSlowLen)
    float eSlow = ta.ema(close, emaTrendLen)
    trendEma20On and trendEma50On and trendEma200On and close > eFast and eFast > eMid and eMid > eSlow and close > eSlow

f_zf_strong_downtrend() =>
    float eFast = ta.ema(close, emaFastLen)
    float eMid  = ta.ema(close, emaSlowLen)
    float eSlow = ta.ema(close, emaTrendLen)
    trendEma20On and trendEma50On and trendEma200On and close < eFast and eFast < eMid and eMid < eSlow and close < eSlow

int zfSwingLen = trendUseLocSwing ? swingLength : trendSwingManual
[zfStructDir, _, _, _, _, _, _, _] = f_structure_pack(zfSwingLen)

bool zfStrongUpBars = f_zf_strong_uptrend()
bool zfStrongDnBars = f_zf_strong_downtrend()
float zfTrendRaw = zfStructDir == 1 or zfStructDir == -1 ? 40.0 : 0.0
zfTrendRaw += zfStructDir == 1 and zfStrongUpBars ? 35.0 : zfStructDir == -1 and zfStrongDnBars ? 35.0 : zfStructDir != 0 ? 15.0 : 0.0
int zfTrendScore = int(math.round(math.min(zfTrendRaw, 100.0)))

bool zoneFilterStrongUp   = zfTrendScore >= trendScoreStrong and zfStructDir == 1
bool zoneFilterStrongDown = zfTrendScore >= trendScoreStrong and zfStructDir == -1

f_loc_zone_side_ok(bool _isDemand, float _pct) =>
    if loc_zone_filter == "Vypnuto" or not zoneLocValid or na(_pct)
        true
    else if loc_zone_filter == "Manual (klasika)"
        _isDemand ? _pct <= 50.0 : _pct >= 50.0
    else
        zoneFilterStrongUp and _isDemand ? true :
         zoneFilterStrongDown and not _isDemand ? true :
         _isDemand ? _pct <= 50.0 : _pct >= 50.0

type Zone
    box  b
    line sl
    int  created_at
    float pref_top
    float pref_bot
    bool converted
    bool strong
    bool isDemand
    bool isTop

var Zone[] demands  = array.new<Zone>()
var Zone[] supplies = array.new<Zone>()

f_zoneColor(bool _isDemand, bool _strong) =>
    color c = na
    if _isDemand
        c := _strong ? #00e676 : #66ffa6
    else
        c := _strong ? #ff5252 : #ff8a80
    c

if show_zones and trialOk
    if imp_up and base_ok_for_demand
        bool strong = is_imp_str
        float top_d = high[1]
        float bot_d = low[1]
        float pref_top_d = math.max(open[1], close[1])
        float pref_bot_d = low[1]
        color col = f_zoneColor(true, strong)
        bool topFlag = isTopDemand
        string txt = topFlag ? "TOP DEMAND\nIN/OUT" + (strong ? "\nSTRONG" : "") : "DEMAND" + (strong ? "\nSTRONG" : "")
        box b = box.new(
             bar_index[1],
             top_d,
             bar_index + extend_bars,
             bot_d,
             bgcolor=color.new(col, 80),
             border_color=col,
             text=txt,
             text_color=color.white,
             text_size=size.tiny
        )
        float sl_p = bot_d - atr * sl_buffer
        line l = line.new(
             bar_index[1],
             sl_p,
             bar_index + extend_bars,
             sl_p,
             color=color.new(col, 60),
             style=line.style_dashed
        )
        array.push(demands, Zone.new(b, l, bar_index[1], pref_top_d, pref_bot_d, false, strong, true, topFlag))
        if array.size(demands) > max_demands_count
            Zone old_z = array.shift(demands)
            box.delete(old_z.b)
            line.delete(old_z.sl)

    if imp_dn and base_ok_for_supply
        bool strong = is_imp_str
        float top_s = high[1]
        float bot_s = low[1]
        float pref_top_s = high[1]
        float pref_bot_s = math.min(open[1], close[1])
        color col = f_zoneColor(false, strong)
        bool topFlag = isTopSupply
        string txt = topFlag ? "TOP SUPPLY\nIN/OUT" + (strong ? "\nSTRONG" : "") : "SUPPLY" + (strong ? "\nSTRONG" : "")
        box b = box.new(
             bar_index[1],
             top_s,
             bar_index + extend_bars,
             bot_s,
             bgcolor=color.new(col, 80),
             border_color=col,
             text=txt,
             text_color=color.white,
             text_size=size.tiny
        )
        float sl_p = top_s + atr * sl_buffer
        line l = line.new(
             bar_index[1],
             sl_p,
             bar_index + extend_bars,
             sl_p,
             color=color.new(col, 60),
             style=line.style_dashed
        )
        array.push(supplies, Zone.new(b, l, bar_index[1], pref_top_s, pref_bot_s, false, strong, false, topFlag))
        if array.size(supplies) > max_supplies_count
            Zone old_z = array.shift(supplies)
            box.delete(old_z.b)
            line.delete(old_z.sl)

mitig_factor = mitigate_limit / 100.0

if trialOk and array.size(demands) > 0
    for i = array.size(demands) - 1 to 0
        Zone z = array.get(demands, i)
        float top = box.get_top(z.b)
        float bot = box.get_bottom(z.b)
        float h = top - bot
        bool is_retest = bar_index > z.created_at + 1
        bool touched_full_zone = is_retest and low <= top and high >= bot
        if touched_full_zone and not z.converted
            box.set_top(z.b, z.pref_top)
            box.set_bottom(z.b, z.pref_bot)
            string txt = z.isTop ? "PREF TOP DEMAND\nIN/OUT" : "PREF DEMAND"
            if z.strong
                txt += "\nSTRONG"
            box.set_text(z.b, txt)
            z.converted := true
            array.set(demands, i, z)
            top := box.get_top(z.b)
            bot := box.get_bottom(z.b)
            h := top - bot
        float limit = top - h * mitig_factor
        bool kill = false
        if z.converted
            if low < limit or close < bot
                kill := true
        else
            if close < bot
                kill := true
        if kill
            if del_broken
                box.delete(z.b)
                line.delete(z.sl)
            array.remove(demands, i)
        else
            box.set_right(z.b, bar_index + extend_bars)
            line.set_x2(z.sl, bar_index + extend_bars)

if trialOk and array.size(supplies) > 0
    for i = array.size(supplies) - 1 to 0
        Zone z = array.get(supplies, i)
        float top = box.get_top(z.b)
        float bot = box.get_bottom(z.b)
        float h = top - bot
        bool is_retest = bar_index > z.created_at + 1
        bool touched_full_zone = is_retest and high >= bot and low <= top
        if touched_full_zone and not z.converted
            box.set_top(z.b, z.pref_top)
            box.set_bottom(z.b, z.pref_bot)
            string txt = z.isTop ? "PREF TOP SUPPLY\nIN/OUT" : "PREF SUPPLY"
            if z.strong
                txt += "\nSTRONG"
            box.set_text(z.b, txt)
            z.converted := true
            array.set(supplies, i, z)
            top := box.get_top(z.b)
            bot := box.get_bottom(z.b)
            h := top - bot
        float limit = bot + h * mitig_factor
        bool kill = false
        if z.converted
            if high > limit or close > top
                kill := true
        else
            if close > top
                kill := true
        if kill
            if del_broken
                box.delete(z.b)
                line.delete(z.sl)
            array.remove(supplies, i)
        else
            box.set_right(z.b, bar_index + extend_bars)
            line.set_x2(z.sl, bar_index + extend_bars)

// =====================================================================
// LOCATION
// =====================================================================
labelSize = locationSize == "Small" ? size.small : locationSize == "Large" ? size.large : size.normal

htfHigh = request.security(syminfo.tickerid, locationTF, ta.highest(high, swingLength), lookahead=barmerge.lookahead_off)
htfLow  = request.security(syminfo.tickerid, locationTF, ta.lowest(low, swingLength), lookahead=barmerge.lookahead_off)

rangeValid = show_location and not na(htfHigh) and not na(htfLow) and htfHigh > htfLow
rangeSize  = rangeValid ? (htfHigh - htfLow) : na

loc_mid       = rangeValid ? htfLow + rangeSize * 0.50 : na
premiumLevel  = rangeValid ? htfLow + rangeSize * 0.75 : na
discountLevel = rangeValid ? htfLow + rangeSize * 0.25 : na

startTimeHigh = request.security(syminfo.tickerid, locationTF, time[math.abs(ta.highestbars(high, swingLength))], lookahead=barmerge.lookahead_off)
startTimeLow  = request.security(syminfo.tickerid, locationTF, time[math.abs(ta.lowestbars(low, swingLength))], lookahead=barmerge.lookahead_off)
rangeStartTime = rangeValid ? math.min(startTimeHigh, startTimeLow) : na

locationPct = rangeValid ? ((close - htfLow) / rangeSize) * 100.0 : na
clampedPct  = na(locationPct) ? na : math.max(0.0, math.min(100.0, locationPct))

locationText =
     not rangeValid ? "N/A" :
     clampedPct >= 75 ? "TOP PREMIUM" :
     clampedPct >= 50 ? "PREMIUM" :
     clampedPct >= 25 ? "DISCOUNT" :
     "TOP DISCOUNT"

locationColor =
     not rangeValid ? color.gray :
     clampedPct >= 75 ? topPremiumColor :
     clampedPct >= 50 ? premiumColor :
     clampedPct >= 25 ? discountColor :
     topDiscountColor

midStatusText =
     not rangeValid ? "N/A" :
     close > loc_mid ? "ABOVE MID" :
     close < loc_mid ? "BELOW MID" :
     "AT MID"

currentText =
     locationSize == "Small" ?
     locationText + " • " + (rangeValid ? str.tostring(clampedPct, "#.##") + "%" : "N/A") :
     locationSize == "Large" ?
     "LOCATION\n" + locationText + "\n" + (rangeValid ? str.tostring(clampedPct, "#.##") + "%" : "N/A") + (showTFLabel ? "\nTF: " + locationTF : "") :
     "LOCATION: " + locationText + "\n" + (rangeValid ? str.tostring(clampedPct, "#.##") + "%" : "N/A") + (showTFLabel ? "\nTF: " + locationTF : "")

var line topPremiumLine   = na
var line premiumLineObj   = na
var line midLineObj       = na
var line discountLineObj  = na
var line topDiscountLine  = na
var label currentLabel    = na
var label topPremiumTag   = na
var label premiumTag      = na
var label midTag          = na
var label discountTag     = na
var label topDiscountTag  = na

if barstate.islast and trialOk
    if show_location and rangeValid and not na(rangeStartTime)
        if na(topPremiumLine)
            topPremiumLine := line.new(rangeStartTime, htfHigh, time, htfHigh, xloc=xloc.bar_time, extend=extend.none, color=color.new(topPremiumColor, 0), style=line.style_dashed, width=2)
        else
            line.set_xy1(topPremiumLine, rangeStartTime, htfHigh)
            line.set_xy2(topPremiumLine, time, htfHigh)

        if na(premiumLineObj)
            premiumLineObj := line.new(rangeStartTime, premiumLevel, time, premiumLevel, xloc=xloc.bar_time, extend=extend.none, color=color.new(premiumColor, 15), style=line.style_dotted, width=1)
        else
            line.set_xy1(premiumLineObj, rangeStartTime, premiumLevel)
            line.set_xy2(premiumLineObj, time, premiumLevel)

        if showMidline
            if na(midLineObj)
                midLineObj := line.new(rangeStartTime, loc_mid, time, loc_mid, xloc=xloc.bar_time, extend=extend.none, color=color.new(midColor, 25), style=line.style_dashed, width=1)
            else
                line.set_xy1(midLineObj, rangeStartTime, loc_mid)
                line.set_xy2(midLineObj, time, loc_mid)
        else
            if not na(midLineObj)
                line.delete(midLineObj)
                midLineObj := na

        if na(discountLineObj)
            discountLineObj := line.new(rangeStartTime, discountLevel, time, discountLevel, xloc=xloc.bar_time, extend=extend.none, color=color.new(discountColor, 15), style=line.style_dotted, width=1)
        else
            line.set_xy1(discountLineObj, rangeStartTime, discountLevel)
            line.set_xy2(discountLineObj, time, discountLevel)

        if na(topDiscountLine)
            topDiscountLine := line.new(rangeStartTime, htfLow, time, htfLow, xloc=xloc.bar_time, extend=extend.none, color=color.new(topDiscountColor, 0), style=line.style_dashed, width=2)
        else
            line.set_xy1(topDiscountLine, rangeStartTime, htfLow)
            line.set_xy2(topDiscountLine, time, htfLow)

        if showZoneTags
            topPremiumText  = showTFLabel ? "TOP PREMIUM • " + locationTF : "TOP PREMIUM"
            premiumText     = showTFLabel ? "PREMIUM • " + locationTF : "PREMIUM"
            midText         = showTFLabel ? "MID • " + locationTF : "MID"
            discountText    = showTFLabel ? "DISCOUNT • " + locationTF : "DISCOUNT"
            topDiscountText = showTFLabel ? "TOP DISCOUNT • " + locationTF : "TOP DISCOUNT"

            if na(topPremiumTag)
                topPremiumTag := label.new(bar_index + 1, htfHigh, topPremiumText, style=label.style_none, color=color.new(color.black, 100), textcolor=topPremiumColor, size=size.small)
            else
                label.set_x(topPremiumTag, bar_index + 1)
                label.set_y(topPremiumTag, htfHigh)
                label.set_text(topPremiumTag, topPremiumText)

            if na(premiumTag)
                premiumTag := label.new(bar_index + 1, premiumLevel, premiumText, style=label.style_none, color=color.new(color.black, 100), textcolor=premiumColor, size=size.tiny)
            else
                label.set_x(premiumTag, bar_index + 1)
                label.set_y(premiumTag, premiumLevel)
                label.set_text(premiumTag, premiumText)

            if showMidline
                if na(midTag)
                    midTag := label.new(bar_index + 1, loc_mid, midText, style=label.style_none, color=color.new(color.black, 100), textcolor=midColor, size=size.tiny)
                else
                    label.set_x(midTag, bar_index + 1)
                    label.set_y(midTag, loc_mid)
                    label.set_text(midTag, midText)
            else
                if not na(midTag)
                    label.delete(midTag)
                    midTag := na

            if na(discountTag)
                discountTag := label.new(bar_index + 1, discountLevel, discountText, style=label.style_none, color=color.new(color.black, 100), textcolor=discountColor, size=size.tiny)
            else
                label.set_x(discountTag, bar_index + 1)
                label.set_y(discountTag, discountLevel)
                label.set_text(discountTag, discountText)

            if na(topDiscountTag)
                topDiscountTag := label.new(bar_index + 1, htfLow, topDiscountText, style=label.style_none, color=color.new(color.black, 100), textcolor=topDiscountColor, size=size.small)
            else
                label.set_x(topDiscountTag, bar_index + 1)
                label.set_y(topDiscountTag, htfLow)
                label.set_text(topDiscountTag, topDiscountText)

        if showLocationLabel
            if na(currentLabel)
                currentLabel := label.new(bar_index + 1, close, currentText, style=label.style_label_left, color=color.new(locationColor, 82), textcolor=color.white, size=labelSize)
            else
                label.set_x(currentLabel, bar_index + 1)
                label.set_y(currentLabel, close)
                label.set_text(currentLabel, currentText)
                label.set_color(currentLabel, color.new(locationColor, 82))

// =====================================================================
// TREND MODULE (STRUCTURE)
// =====================================================================
int trendSwingLen = trendUseLocSwing ? swingLength : trendSwingManual

[structDir, structHH, structHL, structLH, structLL, earlyStructBull, earlyStructBear, _chartHasPiv] = f_structure_pack(trendSwingLen)

string structLabel =
     structDir == 1 ? "BÝČÍ (HH+HL)" :
     structDir == -1 ? "MEDVĚDÍ (LL+LH)" :
     earlyStructBull ? "NÁZNAK BÝKA" :
     earlyStructBear ? "NÁZNAK MEDVĚDA" : "RANGE / NEJASNÉ"

fastEMA   = ta.ema(close, emaFastLen)
slowEMA   = ta.ema(close, emaSlowLen)
midEMA    = ta.ema(close, emaMidLen)
trendEMA  = ta.ema(close, emaTrendLen)
adxValue  = f_adx(adxLen)

bull_stack =
     pair_bull(fastEMA, slowEMA, trendEma20On, trendEma50On) and
     pair_bull(slowEMA, midEMA, trendEma50On, trendEma100On) and
     pair_bull(midEMA, trendEMA, trendEma100On, trendEma200On)

bear_stack =
     pair_bear(fastEMA, slowEMA, trendEma20On, trendEma50On) and
     pair_bear(slowEMA, midEMA, trendEma50On, trendEma100On) and
     pair_bear(midEMA, trendEMA, trendEma100On, trendEma200On)

score_pair_bull = (pair_bull(fastEMA, slowEMA, trendEma20On, trendEma50On) ? 1.0 : 0.0) +
     (pair_bull(slowEMA, midEMA, trendEma50On, trendEma100On) ? 1.0 : 0.0) +
     (pair_bull(midEMA, trendEMA, trendEma100On, trendEma200On) ? 1.0 : 0.0)

score_pair_bear = (pair_bear(fastEMA, slowEMA, trendEma20On, trendEma50On) ? 1.0 : 0.0) +
     (pair_bear(slowEMA, midEMA, trendEma50On, trendEma100On) ? 1.0 : 0.0) +
     (pair_bear(midEMA, trendEMA, trendEma100On, trendEma200On) ? 1.0 : 0.0)

int emaDir = bull_stack ? 1 : bear_stack ? -1 : 0

string emaConfirmLabel =
     structDir == 0 ? (bull_stack ? "EMA BÝČÍ" : bear_stack ? "EMA MEDVĚDÍ" : "EMA NEUTRÁLNÍ") :
     structDir == emaDir and emaDir != 0 ? "POTVRZUJE" :
     emaDir != 0 and emaDir != structDir ? "PROTI STRUKTUŘE" :
     emaDir == 0 ? "ČÁSTEČNĚ / RANGE" : "ČÁSTEČNĚ"

f_slope_up(float src) =>
    not na(src[trendSlopeLookback]) and src > src[trendSlopeLookback]

f_slope_dn(float src) =>
    not na(src[trendSlopeLookback]) and src < src[trendSlopeLookback]

bool ema50_slope_up  = f_slope_up(slowEMA)
bool ema200_slope_up = f_slope_up(trendEMA)
bool ema50_slope_dn  = f_slope_dn(slowEMA)
bool ema200_slope_dn = f_slope_dn(trendEMA)

e50_up  = trendEma50On and ema50_slope_up
e200_up = trendEma200On and ema200_slope_up
e50_dn  = trendEma50On and ema50_slope_dn
e200_dn = trendEma200On and ema200_slope_dn

spread_20_200 = close != 0.0 and trendEma20On and trendEma200On ? math.abs(fastEMA - trendEMA) / close * 100.0 : na
is_compression  = not na(spread_20_200) and spread_20_200 < trendCompressPct

string biasTf = f_trend_bias_tf()
int biasSwing = trendBiasOn and biasTf != "" ? f_trend_htf_bias_swing(biasTf) : 0

[bDirSec, bHH, bHL, bLH, bLL, bEB, bES, bHasPiv] = f_fetch_htf_structure()

int biasDirFallback = 0
if trendBiasOn and biasTf != "" and not bHasPiv
    float htfHi = request.security(syminfo.tickerid, biasTf, ta.highest(high, biasSwing * 2 + 1), barmerge.gaps_off, barmerge.lookahead_off)
    float htfLo = request.security(syminfo.tickerid, biasTf, ta.lowest(low, biasSwing * 2 + 1), barmerge.gaps_off, barmerge.lookahead_off)
    float htfHiPrev = request.security(syminfo.tickerid, biasTf, ta.highest(high, biasSwing * 2 + 1)[biasSwing], barmerge.gaps_off, barmerge.lookahead_off)
    float htfLoPrev = request.security(syminfo.tickerid, biasTf, ta.lowest(low, biasSwing * 2 + 1)[biasSwing], barmerge.gaps_off, barmerge.lookahead_off)
    float htfCl = request.security(syminfo.tickerid, biasTf, close, barmerge.gaps_off, barmerge.lookahead_off)
    bool fbHH = not na(htfHi) and not na(htfHiPrev) and htfHi > htfHiPrev
    bool fbHL = not na(htfLo) and not na(htfLoPrev) and htfLo > htfLoPrev
    bool fbLH = not na(htfHi) and not na(htfHiPrev) and htfHi < htfHiPrev
    bool fbLL = not na(htfLo) and not na(htfLoPrev) and htfLo < htfLoPrev
    biasDirFallback := fbHH and fbHL ? 1 : fbLH and fbLL ? -1 : htfCl > htfHiPrev and fbHL ? 1 : htfCl < htfLoPrev and fbLL ? -1 : 0
    bHH := fbHH
    bHL := fbHL
    bLH := fbLH
    bLL := fbLL
    bEB := (fbHH or fbHL) and biasDirFallback == 0
    bES := (fbLH or fbLL) and biasDirFallback == 0

int  biasDirRaw = trendBiasOn and biasTf != "" ? bDirSec : 0
int  biasDir    = trendBiasOn and biasTf != "" ? (biasDirRaw != 0 ? biasDirRaw : biasDirFallback) : 0
bool biasEarlyBull = trendBiasOn and biasTf != "" ? (bEB or (biasDir == 0 and (bHH or bHL))) : false
bool biasEarlyBear = trendBiasOn and biasTf != "" ? (bES or (biasDir == 0 and (bLH or bLL))) : false
bool biasUsedFallback = trendBiasOn and biasTf != "" and biasDirRaw == 0 and biasDir != 0 and not bHasPiv

string biasPivotTxt = trendBiasOn and biasTf != "" ? f_pivot_tags(bHH, bHL, bLH, bLL) : "—"

string htfBiasLabel =
     not trendBiasOn or biasTf == "" ? "—" :
     biasDir == 1 ? (biasDirRaw == 1 ? "BÝČÍ · HH+HL" : "BÝČÍ · swing box") :
     biasDir == -1 ? (biasDirRaw == -1 ? "MEDVĚDÍ · LL+LH" : "MEDVĚDÍ · swing box") :
     biasEarlyBull ? "NÁZNAK BÝKA" :
     biasEarlyBear ? "NÁZNAK MEDVĚDA" :
     "RANGE / ČEKÁ"

bool biasAligned = trendBiasOn and biasTf != "" and structDir != 0 and biasDir == structDir
bool biasConflict = trendBiasOn and biasTf != "" and structDir != 0 and biasDir != 0 and biasDir != structDir
bool biasSoftBull = trendBiasOn and biasTf != "" and (structDir == 1 or earlyStructBull) and (biasDir == 1 or biasEarlyBull)
bool biasSoftBear = trendBiasOn and biasTf != "" and (structDir == -1 or earlyStructBear) and (biasDir == -1 or biasEarlyBear)

string biasRelation =
     not trendBiasOn or biasTf == "" ? "—" :
     biasAligned ? "SOULAD · plný trend" :
     biasConflict ? "PROTI HTF" :
     biasSoftBull and not biasAligned ? "LOK. BÝČÍ · HTF částečně" :
     biasSoftBear and not biasAligned ? "LOK. MEDVĚDÍ · HTF částečně" :
     structDir == 1 and biasDir == 0 ? "LOK. BÝČÍ · HTF ČEKÁ" :
     structDir == -1 and biasDir == 0 ? "LOK. MEDVĚDÍ · HTF ČEKÁ" :
     structDir == 0 and biasDir == 1 ? "HTF BÝČÍ · lok. čeká" :
     structDir == 0 and biasDir == -1 ? "HTF MEDVĚDÍ · lok. čeká" :
     structDir == 0 and biasDir == 0 ? "OBA RANGE" :
     "SMÍŠENÉ"

float score_struct =
     structDir == 1 or structDir == -1 ? 40.0 :
     earlyStructBull or earlyStructBear ? 18.0 : 0.0

float score_ema =
     structDir == 1 ? score_pair_bull / 3.0 * 25.0 :
     structDir == -1 ? score_pair_bear / 3.0 * 25.0 :
     math.max(score_pair_bull, score_pair_bear) / 3.0 * 10.0

float score_slope =
     structDir == 1 and e50_up and e200_up ? 10.0 :
     structDir == -1 and e50_dn and e200_dn ? 10.0 :
     structDir == 1 and (e50_up or e200_up) ? 5.0 :
     structDir == -1 and (e50_dn or e200_dn) ? 5.0 : 0.0

total_sep =
     f_gap_pct(fastEMA, slowEMA, trendEma20On, trendEma50On) +
     f_gap_pct(slowEMA, midEMA, trendEma50On, trendEma100On) +
     f_gap_pct(midEMA, trendEMA, trendEma100On, trendEma200On)

float score_sep = trendSepMaxPct > 0.0 ? math.min(total_sep / trendSepMaxPct * 10.0, 10.0) : 0.0
score_sep := is_compression ? score_sep * 0.25 : score_sep

float score_adx =
     adxValue >= strongTrendThreshold ? 10.0 :
     adxValue >= rangeThreshold ? 5.0 : 0.0

dist200 = trendEma200On and trendEMA != 0.0 ? (close - trendEMA) / trendEMA * 100.0 : na

float score_px =
     not trendEma200On or na(dist200) ? 0.0 :
     structDir == 1 and close > trendEMA ? 5.0 :
     structDir == -1 and close < trendEMA ? 5.0 : 0.0

float rawTrendScore = score_struct + score_ema + score_slope + score_sep + score_adx + score_px

if structDir != 0 and emaDir != 0 and emaDir != structDir
    rawTrendScore *= 0.75

if biasAligned
    rawTrendScore := math.min(rawTrendScore + 8.0, 100.0)
else if biasSoftBull or biasSoftBear
    rawTrendScore := math.min(rawTrendScore + 4.0, 100.0)

if biasConflict
    rawTrendScore *= 0.85

trendScore = int(math.round(math.min(rawTrendScore, 100.0)))

trendState =
     is_compression ? "KOMPRESE" :
     trendScore >= trendScoreStrong and structDir == 1 ? "SILNÝ BÝČÍ" :
     trendScore >= trendScoreStrong and structDir == -1 ? "SILNÝ MEDVĚDÍ" :
     structDir == 1 ? "SLABÝ BÝČÍ" :
     structDir == -1 ? "SLABÝ MEDVĚDÍ" :
     earlyStructBull or earlyStructBear ? "FORMUJE SE" :
     "RANGE"

marketCondition = f_market_condition(adxValue, trendScore, is_compression, structDir)
stateColor = f_trend_row_color(trendScore)

plot(trialOk and showTrendEma and trendEma20On ? fastEMA : na, "EMA 20", color=structDir == 1 ? color.rgb(0, 230, 140) : structDir == -1 ? color.rgb(220, 80, 80) : color.gray, linewidth=2)
plot(trialOk and showTrendEma and trendEma50On ? slowEMA : na, "EMA 50", color=structDir == 1 ? color.rgb(0, 230, 140) : structDir == -1 ? color.rgb(220, 80, 80) : color.gray, linewidth=2)
plot(trialOk and showTrendEma and trendEma100On ? midEMA : na, "EMA 100", color.new(#FF9800, 0), linewidth=2)
plot(trialOk and showTrendEma and trendEma200On ? trendEMA : na, "EMA 200", color.new(#2196F3, 0), linewidth=3)

canColorBars = not colorOnlyWithBias or biasAligned or (biasSoftBull and structDir == 1) or (biasSoftBear and structDir == -1)
barcolor(trialOk and barColorEnabled and canColorBars ? f_bar_color_struct(structDir) : na)

strongUp   = trendScore >= trendScoreStrong and structDir == 1
weakUp     = structDir == 1 and trendScore < trendScoreStrong
isRange    = structDir == 0
weakDown   = structDir == -1 and trendScore < trendScoreStrong
strongDown = trendScore >= trendScoreStrong and structDir == -1

structBullNew = structDir == 1 and structDir[1] != 1
structBearNew = structDir == -1 and structDir[1] != -1
biasAlignNew  = biasAligned and not biasAligned[1]
trendScoreCrossStrong = trendScore >= trendScoreStrong and trendScore[1] < trendScoreStrong

// =====================================================================
// SEASONALITY MODULE (BIAS ONLY)
// =====================================================================
season_isW = season_mode == "Weekly" ? true : season_mode == "Daily" ? false : timeframe.isweekly
season_tf = season_isW ? "W" : "D"
season_bucketMax = season_isW ? 52 : 365

season_srcTime = request.security(syminfo.tickerid, season_tf, time, barmerge.gaps_on, barmerge.lookahead_off)
season_srcRet  = request.security(syminfo.tickerid, season_tf, season_useLogRet ? math.log(close / close[1]) : (close / close[1] - 1.0), barmerge.gaps_on, barmerge.lookahead_off) * season_scaleFactor

f_isLeap(_y) =>
    (_y % 4 == 0 and _y % 100 != 0) or (_y % 400 == 0)

f_doy(_t) =>
    _y = year(_t)
    _m = month(_t)
    _d = dayofmonth(_t)
    _out = _d
    if _m > 1
        _out += 31
    if _m > 2
        _out += f_isLeap(_y) ? 29 : 28
    if _m > 3
        _out += 31
    if _m > 4
        _out += 30
    if _m > 5
        _out += 31
    if _m > 6
        _out += 30
    if _m > 7
        _out += 31
    if _m > 8
        _out += 31
    if _m > 9
        _out += 30
    if _m > 10
        _out += 31
    if _m > 11
        _out += 30
    _out

f_bucket(_t, _isW) =>
    _b = 1
    if _isW
        _w = weekofyear(_t)
        _b := math.min(_w, 52)
    else
        _d = f_doy(_t)
        _b := math.min(_d, 365)
    _b

f_cycle(_y) =>
    _rem = _y % 4
    _rem == 0 ? "Election" : _rem == 1 ? "Post-Election" : _rem == 2 ? "Midterm" : "Pre-Election"

f_cycleAllowed(_y, _enable, _mode, _currentCycle) =>
    _ok = true
    if _enable
        if _mode == "Vsechny roky"
            _ok := true
        else if _mode == "Auto"
            _ok := f_cycle(_y) == _currentCycle
        else
            _ok := f_cycle(_y) == _mode
    _ok

f_yearAllowed(_y, _from, _to, _enable, _mode, _currentCycle) =>
    (_y >= _from and _y <= _to) and f_cycleAllowed(_y, _enable, _mode, _currentCycle)

f_smooth(_bucket, _sumArr, _cntArr, _len, _maxBucket) =>
    _sum = 0.0
    _cnt = 0
    _half = int(math.floor(_len / 2))
    for _i = 0 to _len - 1
        _idx = _bucket - (_i - _half)
        if _idx < 1
            _idx := _maxBucket + _idx
        if _idx > _maxBucket
            _idx := _idx - _maxBucket
        _c = array.get(_cntArr, _idx)
        _v = _c > 0 ? array.get(_sumArr, _idx) / _c : 0.0
        _sum += _v
        _cnt += 1
    _cnt > 0 ? (_sum / _cnt) : 0.0

yNow = year(timenow)
currentCycle = f_cycle(yNow)
season_yFromEff = season_yearsMode == "Vse" ? 1900 : season_yearsMode == "Poslednich N let" ? (yNow - season_yearsN + 1) : season_yearFrom
season_yToEff   = season_yearsMode == "Vse" ? 2100 : season_yearsMode == "Poslednich N let" ? yNow : season_yearTo

var season_sumR = array.new_float(366, 0.0)
var season_cntR = array.new_int(366, 0)
var int season_dataPoints = 0
var int lastSeasonYear = na
var int lastSeasonBucket = na

if barstate.isfirst
    for i = 0 to 365
        array.set(season_sumR, i, 0.0)
        array.set(season_cntR, i, 0)
    season_dataPoints := 0
    lastSeasonYear := na
    lastSeasonBucket := na

if not na(season_srcTime) and not na(season_srcRet)
    sy = year(season_srcTime)
    sb = f_bucket(season_srcTime, season_isW)
    bool isFreshSeasonBar = na(lastSeasonYear) or na(lastSeasonBucket) or sy != lastSeasonYear or sb != lastSeasonBucket
    if isFreshSeasonBar
        if f_yearAllowed(sy, season_yFromEff, season_yToEff, season_enableElection, season_filterMode, currentCycle)
            if sb >= 1 and sb <= season_bucketMax
                array.set(season_sumR, sb, array.get(season_sumR, sb) + season_srcRet)
                array.set(season_cntR, sb, array.get(season_cntR, sb) + 1)
                season_dataPoints += 1
        lastSeasonYear := sy
        lastSeasonBucket := sb

float season_avgHere = na
int season_bNow = f_bucket(time, season_isW)
if season_bNow >= 1
    float running = 0.0
    for i = 1 to season_bNow
        running += f_smooth(i, season_sumR, season_cntR, season_smoothLen, season_bucketMax)
    season_avgHere := running

float season_slope = na
if not na(season_avgHere[season_slopeLookback])
    season_slope := season_avgHere - season_avgHere[season_slopeLookback]

season_strongThreshold = season_slopeThreshold * season_strongMultiplier
season_slopeBull = not na(season_slope) and season_slope > season_slopeThreshold
season_slopeBear = not na(season_slope) and season_slope < -season_slopeThreshold
season_strongBullSlope = not na(season_slope) and season_slope > season_strongThreshold
season_strongBearSlope = not na(season_slope) and season_slope < -season_strongThreshold

float season_projDiff = na
if not na(season_avgHere)
    season_steps = season_isW ? season_futureWeeks : season_futureDays
    _lastY = season_avgHere
    _lastT = time
    for k = 1 to season_steps
        _nextT = _lastT + (season_isW ? 604800000 : 86400000)
        _bNext = f_bucket(_nextT, season_isW)
        _avgChange = f_smooth(_bNext, season_sumR, season_cntR, season_smoothLen, season_bucketMax) * season_projectionFactor
        _nextY = _lastY + _avgChange
        _lastT := _nextT
        _lastY := _nextY
    season_projDiff := _lastY - season_avgHere

season_projUp   = not na(season_projDiff) and season_projDiff > 0
season_projDown = not na(season_projDiff) and season_projDiff < 0

season_bullConfluence = season_slopeBull and season_projUp
season_bearConfluence = season_slopeBear and season_projDown
season_strongBullConfluence = season_strongBullSlope and season_projUp
season_strongBearConfluence = season_strongBearSlope and season_projDown

seasonBiasText = season_strongBullConfluence ? "BULLISH" : season_strongBearConfluence ? "BEARISH" : season_bullConfluence ? "BULLISH" : season_bearConfluence ? "BEARISH" : "NEUTRAL"
seasonStrengthText = season_strongBullConfluence or season_strongBearConfluence ? "STRONG" : season_bullConfluence or season_bearConfluence ? "MEDIUM" : season_slopeBull or season_slopeBear ? "WEAK" : "NEUTRAL"
seasonScore = season_strongBullConfluence ? 2 : season_bullConfluence ? 1 : season_strongBearConfluence ? -2 : season_bearConfluence ? -1 : 0
seasonConfidenceText = season_dataPoints > 1000 ? "HIGH" : season_dataPoints > 500 ? "MEDIUM" : "LOW"

// =====================================================================
// FUSION / AI LOGIC
// =====================================================================
float trendModuleScore = trendScore

float cotModuleScore = na(comBias52) or na(comBias26) ? 50 :
     cotState == "TREND LONG" ? 85 :
     cotState == "TREND SHORT" ? 15 :
     cotState == "ACCUMULATION" ? 65 :
     cotState == "DISTRIBUTION" ? 35 : 50

float locationModuleScore = not rangeValid ? 50 :
     clampedPct >= 75 ? 20 :
     clampedPct >= 50 ? 40 :
     clampedPct >= 25 ? 60 : 80

f_gradeToScore(_grade, _hiVol, _strong) =>
    float sc = _grade == "A++" ? 92 : _grade == "A" ? 78 : 58
    sc += _hiVol ? 4 : 0
    sc += _strong ? 4 : 0
    math.min(sc, 100)

float activeSupplyScore = na
float activeDemandScore = na
float nearestSupplyTop = na
float nearestSupplyBot = na
float nearestDemandTop = na
float nearestDemandBot = na
bool locationPrefersSupply = rangeValid and clampedPct >= 50
bool locationPrefersDemand = rangeValid and clampedPct < 50
bool cotBullConfirm = cotState == "TREND LONG" or cotState == "ACCUMULATION"
bool cotBearConfirm = cotState == "TREND SHORT" or cotState == "DISTRIBUTION"
bool fusionStrongUp   = loc_zone_filter == "Auto (trend)" ? zoneFilterStrongUp : strongUp
bool fusionStrongDown = loc_zone_filter == "Auto (trend)" ? zoneFilterStrongDown : strongDown
bool allowDemandContinuation = fusionStrongUp and cotBullConfirm
bool allowSupplyContinuation = fusionStrongDown and cotBearConfirm
bool higherBear = biasDir == -1 or structDir == -1 or cotState == "TREND SHORT" or cotState == "DISTRIBUTION"
bool higherBull = biasDir == 1 or structDir == 1 or cotState == "TREND LONG" or cotState == "ACCUMULATION"

float supplyLocTop = na
float supplyLocBot = na
float supplyLocScore = na
float supplyLocDist = na
float supplyAnyTop = na
float supplyAnyBot = na
float supplyAnyScore = na
float supplyAnyDist = na
if array.size(supplies) > 0
    for i = 0 to array.size(supplies) - 1
        Zone zs = array.get(supplies, i)
        float sTop = box.get_top(zs.b)
        float sBot = box.get_bottom(zs.b)
        float sPct = f_zoneLocationPct(sTop, sBot)
        bool sLocBandOk = loc_zone_filter == "Vypnuto" ? (not zoneLocValid or na(sPct) or sPct >= 50.0) : f_loc_zone_side_ok(false, sPct)
        float sDist = close > sTop ? close - sTop : close < sBot ? sBot - close : 0.0
        float sScore = f_gradeToScore(f_getGrade(false), false, zs.strong)
        if sLocBandOk and (na(supplyLocDist) or sDist < supplyLocDist)
            supplyLocDist := sDist
            supplyLocTop := sTop
            supplyLocBot := sBot
            supplyLocScore := sScore
        if na(supplyAnyDist) or sDist < supplyAnyDist
            supplyAnyDist := sDist
            supplyAnyTop := sTop
            supplyAnyBot := sBot
            supplyAnyScore := sScore

float demandLocTop = na
float demandLocBot = na
float demandLocScore = na
float demandLocDist = na
float demandAnyTop = na
float demandAnyBot = na
float demandAnyScore = na
float demandAnyDist = na
if array.size(demands) > 0
    for i = 0 to array.size(demands) - 1
        Zone zd = array.get(demands, i)
        float dTop = box.get_top(zd.b)
        float dBot = box.get_bottom(zd.b)
        float dPct = f_zoneLocationPct(dTop, dBot)
        bool dLocBandOk = loc_zone_filter == "Vypnuto" ? (not zoneLocValid or na(dPct) or dPct < 50.0) : f_loc_zone_side_ok(true, dPct)
        float dDist = close > dTop ? close - dTop : close < dBot ? dBot - close : 0.0
        float dScore = f_gradeToScore(f_getGrade(true), false, zd.strong)
        if dLocBandOk and (na(demandLocDist) or dDist < demandLocDist)
            demandLocDist := dDist
            demandLocTop := dTop
            demandLocBot := dBot
            demandLocScore := dScore
        if na(demandAnyDist) or dDist < demandAnyDist
            demandAnyDist := dDist
            demandAnyTop := dTop
            demandAnyBot := dBot
            demandAnyScore := dScore

string mainZoneSide = "NONE"
float mainZoneScore = na

if locationPrefersSupply
    if not na(supplyLocDist)
        nearestSupplyTop := supplyLocTop
        nearestSupplyBot := supplyLocBot
        activeSupplyScore := supplyLocScore
        mainZoneScore := supplyLocScore
        mainZoneSide := "SUPPLY"
    else if not na(supplyAnyDist)
        nearestSupplyTop := supplyAnyTop
        nearestSupplyBot := supplyAnyBot
        activeSupplyScore := supplyAnyScore
        mainZoneScore := supplyAnyScore
        mainZoneSide := "SUPPLY"
    else if allowDemandContinuation and not na(demandAnyDist)
        nearestDemandTop := demandAnyTop
        nearestDemandBot := demandAnyBot
        activeDemandScore := demandAnyScore
        mainZoneScore := demandAnyScore
        mainZoneSide := "DEMAND"
else if locationPrefersDemand
    if not na(demandLocDist)
        nearestDemandTop := demandLocTop
        nearestDemandBot := demandLocBot
        activeDemandScore := demandLocScore
        mainZoneScore := demandLocScore
        mainZoneSide := "DEMAND"
    else if not na(demandAnyDist)
        nearestDemandTop := demandAnyTop
        nearestDemandBot := demandAnyBot
        activeDemandScore := demandAnyScore
        mainZoneScore := demandAnyScore
        mainZoneSide := "DEMAND"
    else if allowSupplyContinuation and not na(supplyAnyDist)
        nearestSupplyTop := supplyAnyTop
        nearestSupplyBot := supplyAnyBot
        activeSupplyScore := supplyAnyScore
        mainZoneScore := supplyAnyScore
        mainZoneSide := "SUPPLY"
else
    if higherBear and not na(supplyAnyDist)
        nearestSupplyTop := supplyAnyTop
        nearestSupplyBot := supplyAnyBot
        activeSupplyScore := supplyAnyScore
        mainZoneScore := supplyAnyScore
        mainZoneSide := "SUPPLY"
    else if higherBull and not na(demandAnyDist)
        nearestDemandTop := demandAnyTop
        nearestDemandBot := demandAnyBot
        activeDemandScore := demandAnyScore
        mainZoneScore := demandAnyScore
        mainZoneSide := "DEMAND"

float zoneModuleScore = nz(mainZoneScore, 50)

float seasonModuleScore = seasonScore == 2 ? 85 : seasonScore == 1 ? 65 : seasonScore == -1 ? 35 : seasonScore == -2 ? 15 : 50

float totalWeight = fusionWeightTrend + fusionWeightCOT + fusionWeightLoc + fusionWeightZone + fusionWeightSeason
float fusionScore = totalWeight == 0 ? 50 :
     (trendModuleScore * fusionWeightTrend + cotModuleScore * fusionWeightCOT + locationModuleScore * fusionWeightLoc + zoneModuleScore * fusionWeightZone + seasonModuleScore * fusionWeightSeason) / totalWeight
fusionScore := math.round(fusionScore)

string fusionText = f_score_to_text(fusionScore)
color fusionColor = f_score_color(fusionScore)

string smartMoneyBias = comDir26 == "LONG" and comDir52 == "LONG" ? "BUY / ACCUMULATION" :
     comDir26 == "SHORT" and comDir52 == "SHORT" ? "SELL / DISTRIBUTION" : cotState

string retailPositioning = retDir26
string cotWeeklyText = na(comBias52) ? "N/A" : comDir52 + " " + str.tostring(math.round(comBias52))

string panelVerdictHead =
     is_compression ? "⏸ ČEKAT" :
     biasConflict ? "⚠ OPATRNĚ" :
     higherBull and clampedPct <= 50 and biasAligned and trendScore >= trendScoreStrong ? "▲ LONG SETUP" :
     higherBear and clampedPct >= 50 and biasAligned and trendScore >= trendScoreStrong ? "▼ SHORT SETUP" :
     higherBull and clampedPct <= 50 ? "▲ BÝČÍ KONTEXT" :
     higherBear and clampedPct >= 50 ? "▼ MEDVĚDÍ KONTEXT" :
     higherBear and clampedPct < 50 ? "▼ MEDVĚDÍ · čekej pullback" :
     higherBull and clampedPct > 50 ? "▲ BÝČÍ · čekej pullback" :
     "◆ MIX / RANGE"

string panelVerdictSub =
     is_compression ? "komprese EMA · nevstupovat" :
     biasConflict ? "lokální trend vs " + (trendBiasOn and biasTf != "" ? biasTf : "HTF") :
     biasAligned ? "soulad graf + HTF + lokace" :
     "sleduj HTF a zónu"

string panelStructShort =
     structDir == 1 ? "HH+HL" :
     structDir == -1 ? "LL+LH" :
     earlyStructBull ? "náznak býka" :
     earlyStructBear ? "náznak medvěda" : "range"

string panelEmaShort =
     emaConfirmLabel == "POTVRZUJE" ? "✓ potvrzuje" :
     str.contains(emaConfirmLabel, "PROTI") ? "✗ proti" :
     emaConfirmLabel == "ČÁSTEČNĚ" ? "◐ částečně" : "— neutrální"

string panelSouladShort =
     biasConflict ? "✗ PROTI " + biasTf :
     biasAligned ? "✓ soulad" :
     biasSoftBull or biasSoftBear ? "◐ částečně" : "— čeká"

string panelHtfShort =
     not trendBiasOn or biasTf == "" ? "—" :
     f_dir_chip(biasDir) + " · " + biasTf

string panelCotShort =
     comDir52 == "LONG" ? "▲ LONG " + str.tostring(math.round(nz(comBias52, 0))) :
     comDir52 == "SHORT" ? "▼ SHORT " + str.tostring(math.round(nz(comBias52, 0))) :
     "— N/A"

string panelSeasonShort =
     season_strongBearConfluence ? "▼ silně medvědí" :
     season_strongBullConfluence ? "▲ silně býčí" :
     season_bearConfluence ? "▼ medvědí" :
     season_bullConfluence ? "▲ býčí" : "◆ neutrální"

string aiVerdict = panelVerdictHead

float suggestedEntry = na
string suggestedMode = "WAIT"
string invalidationText = "N/A"

if mainZoneSide == "SUPPLY" and not na(nearestSupplyBot)
    suggestedEntry := nearestSupplyBot
    suggestedMode := "SHORT REACTION"
    invalidationText := not na(nearestSupplyTop) ? "Daily close above " + str.tostring(nearestSupplyTop, format.mintick) : "N/A"
else if mainZoneSide == "DEMAND" and not na(nearestDemandTop)
    suggestedEntry := nearestDemandTop
    suggestedMode := "LONG REACTION"
    invalidationText := not na(nearestDemandBot) ? "Daily close below " + str.tostring(nearestDemandBot, format.mintick) : "N/A"

string path1 = higherBear ? "Short rejection" : higherBull ? "Long continuation" : "Range continuation"
string path2 = higherBear ? "Deeper pullback" : higherBull ? "Pullback before continuation" : "Liquidity sweep"
string path3 = higherBear ? "Counter-trend bounce" : higherBull ? "Counter-trend drop" : "Breakout"

int p1 = higherBear ? 62 : higherBull ? 62 : 40
int p2 = 23
int p3 = 15

// =====================================================================
// FUSION PANEL — přehled do ~3 s (verdikt → trend → kontext → akce)
// =====================================================================
color P_BG_HDR  = color.rgb(22, 26, 42)
color P_BG_VER  = color.rgb(28, 32, 52)
color P_BG_A    = color.rgb(16, 18, 28)
color P_BG_B    = color.rgb(22, 25, 36)
color P_BG_ACT  = color.rgb(32, 38, 58)
color P_TX_DIM  = color.rgb(130, 138, 158)
color P_TX      = color.rgb(235, 238, 245)

verdictCol = f_verdict_color(panelVerdictHead)
htfCol = biasDir == 1 ? color.rgb(0, 230, 140) : biasDir == -1 ? color.rgb(255, 82, 82) : color.rgb(255, 202, 40)
grafCol = structDir == 1 ? color.rgb(0, 200, 120) : structDir == -1 ? color.rgb(255, 90, 90) : color.rgb(255, 202, 40)
souladCol = biasConflict ? color.rgb(255, 202, 40) : biasAligned ? color.rgb(0, 230, 140) : color.rgb(160, 165, 180)

string panelZoneShort =
     mainZoneSide == "DEMAND" ? "DEMAND " + (na(activeDemandScore) ? "" : str.tostring(math.round(activeDemandScore))) :
     mainZoneSide == "SUPPLY" ? "SUPPLY " + (na(activeSupplyScore) ? "" : str.tostring(math.round(activeSupplyScore))) :
     "bez zóny"

string panelEntryShort =
     suggestedMode == "WAIT" ? "čekat na zónu" :
     suggestedMode + (na(suggestedEntry) ? "" : " @ " + str.tostring(suggestedEntry, format.mintick))

string panelStopShort =
     invalidationText == "N/A" ? "—" :
     str.contains(invalidationText, "below") ? str.replace(invalidationText, "Daily close below ", "pod ") :
     str.contains(invalidationText, "above") ? str.replace(invalidationText, "Daily close above ", "nad ") :
     invalidationText

var table fusionTbl = table.new(position.top_right, 2, 14, border_width=1, border_color=color.rgb(55, 62, 82), frame_color=color.rgb(55, 62, 82), frame_width=1)

if barstate.islast and showFusionPanel and trialOk
    table.clear(fusionTbl, 0, 0, 1, 13)
    szVerdict = f_panel_verdict_sz(panelVerdictSize)
    szVerdictSub = f_panel_verdict_sub_sz(panelVerdictSize)
    szVerdictScore = f_panel_verdict_score_sz(panelVerdictSize)
    szVal = f_panel_table_val_sz(panelVerdictSize)
    szSub = f_panel_table_sub_sz(panelVerdictSize)

    table.cell(fusionTbl, 0, 0, panelVerdictHead, text_color=verdictCol, text_size=szVerdict, bgcolor=P_BG_VER, text_halign=text.align_left)
    table.cell(fusionTbl, 1, 0, str.tostring(fusionScore) + " · " + fusionText, text_color=fusionColor, text_size=szVerdictScore, bgcolor=P_BG_VER, text_halign=text.align_right)
    table.cell(fusionTbl, 0, 1, panelVerdictSub, text_color=P_TX_DIM, text_size=szVerdictSub, bgcolor=P_BG_VER, text_halign=text.align_left)
    table.cell(fusionTbl, 1, 1, f_tf_label() + " · swing " + str.tostring(trendSwingLen), text_color=P_TX_DIM, text_size=szVerdictSub, bgcolor=P_BG_VER, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 2, "HTF", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_A)
    table.cell(fusionTbl, 1, 2, panelHtfShort, text_color=htfCol, text_size=szVal, bgcolor=P_BG_A, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 3, "Graf", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_B)
    table.cell(fusionTbl, 1, 3, panelStructShort + " · skóre " + str.tostring(trendScore), text_color=grafCol, text_size=szVal, bgcolor=P_BG_B, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 4, "EMA", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_A)
    table.cell(fusionTbl, 1, 4, panelEmaShort, text_color=str.contains(panelEmaShort, "✗") ? color.rgb(255, 202, 40) : str.contains(panelEmaShort, "✓") ? color.rgb(0, 230, 140) : P_TX, text_size=szVal, bgcolor=P_BG_A, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 5, "Soulad", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_B)
    table.cell(fusionTbl, 1, 5, panelSouladShort, text_color=souladCol, text_size=szVal, bgcolor=P_BG_B, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 6, "Lokace", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_A)
    locShort = rangeValid ? locationText + " " + str.tostring(clampedPct, "#.0") + "%" : "N/A"
    table.cell(fusionTbl, 1, 6, locShort, text_color=locationColor, text_size=szVal, bgcolor=P_BG_A, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 7, "COT", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_B)
    table.cell(fusionTbl, 1, 7, panelCotShort, text_color=comDir52 == "LONG" ? color.rgb(0, 230, 140) : comDir52 == "SHORT" ? color.rgb(255, 82, 82) : P_TX_DIM, text_size=szVal, bgcolor=P_BG_B, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 8, "Sezóna", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_A)
    table.cell(fusionTbl, 1, 8, panelSeasonShort, text_color=seasonScore > 0 ? color.rgb(0, 230, 140) : seasonScore < 0 ? color.rgb(255, 82, 82) : P_TX_DIM, text_size=szVal, bgcolor=P_BG_A, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 9, "Zóna", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_B)
    table.cell(fusionTbl, 1, 9, panelZoneShort, text_color=mainZoneSide == "DEMAND" ? color.rgb(0, 190, 255) : mainZoneSide == "SUPPLY" ? color.rgb(255, 110, 150) : P_TX_DIM, text_size=szVal, bgcolor=P_BG_B, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 10, "Vstup", text_color=P_TX, text_size=szSub, bgcolor=P_BG_ACT)
    table.cell(fusionTbl, 1, 10, panelEntryShort, text_color=color.white, text_size=szVal, bgcolor=P_BG_ACT, text_halign=text.align_right)

    table.cell(fusionTbl, 0, 11, "Stop", text_color=P_TX, text_size=szSub, bgcolor=P_BG_ACT)
    table.cell(fusionTbl, 1, 11, panelStopShort, text_color=color.rgb(255, 167, 38), text_size=szVal, bgcolor=P_BG_ACT, text_halign=text.align_right)

    scenTxt = showSuggestedPath ? path1 + " · " + str.tostring(p1) + "%" : "—"
    table.cell(fusionTbl, 0, 12, "Scénář", text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_A)
    table.cell(fusionTbl, 1, 12, scenTxt, text_color=P_TX, text_size=szSub, bgcolor=P_BG_A, text_halign=text.align_right)

    trialFoot = "TRIAL · " + str.tostring(trialDaysLeft) + " dní"
    trialFootCol = trialDaysLeft <= 7 ? color.rgb(255, 167, 38) : color.new(P_TX_DIM, 30)
    table.cell(fusionTbl, 0, 13, trialFoot, text_color=trialFootCol, text_size=szSub, bgcolor=P_BG_HDR, text_halign=text.align_center)
    table.cell(fusionTbl, 1, 13, marketCondition, text_color=P_TX_DIM, text_size=szSub, bgcolor=P_BG_HDR, text_halign=text.align_center)

// =====================================================================
// ALERTS
// =====================================================================
alertcondition(trialOk and show_location and rangeValid and ta.crossover(close, premiumLevel), title="Crossed Into Top Premium", message="TITAN LOCATION: Price crossed into Top Premium.")
alertcondition(trialOk and show_location and rangeValid and ta.crossunder(close, premiumLevel), title="Dropped Below Premium", message="TITAN LOCATION: Price dropped below Premium zone.")
alertcondition(trialOk and show_location and rangeValid and ta.crossunder(close, discountLevel), title="Crossed Into Top Discount", message="TITAN LOCATION: Price crossed into Top Discount.")
alertcondition(trialOk and show_location and rangeValid and ta.crossover(close, discountLevel), title="Moved Back Above Discount", message="TITAN LOCATION: Price moved back above Discount zone.")
alertcondition(trialOk and show_location and rangeValid and ta.crossover(close, loc_mid), title="Crossed Above Mid", message="TITAN LOCATION: Price crossed above Mid.")
alertcondition(trialOk and show_location and rangeValid and ta.crossunder(close, loc_mid), title="Crossed Below Mid", message="TITAN LOCATION: Price crossed below Mid.")
alertcondition(trialOk and showFusionPanel and fusionScore >= 80, title="Fusion Score Strong", message="TITAN PRO FUSION: Score is above 80.")
alertcondition(trialOk and showFusionPanel and mainZoneSide == "SUPPLY" and not na(nearestSupplyBot) and high >= nearestSupplyBot and low <= nearestSupplyTop, title="Bearish Supply Reaction Area", message="TITAN PRO FUSION: Price is inside bearish supply reaction area.")
alertcondition(trialOk and showFusionPanel and mainZoneSide == "DEMAND" and not na(nearestDemandBot) and high >= nearestDemandBot and low <= nearestDemandTop, title="Bullish Demand Reaction Area", message="TITAN PRO FUSION: Price is inside bullish demand reaction area.")
alertcondition(trialOk and structBullNew, title="Structure Bull New", message="TITAN PRO FUSION v2: Nova byci struktura HH+HL.")
alertcondition(trialOk and structBearNew, title="Structure Bear New", message="TITAN PRO FUSION v2: Nova medvedi struktura LL+LH.")
alertcondition(trialOk and biasAlignNew, title="Bias Aligned New", message="TITAN PRO FUSION v2: Struktura v souladu s HTF bias.")
alertcondition(trialOk and trendScoreCrossStrong, title="Trend Score Strong", message="TITAN PRO FUSION v2: Trend score crossed strong threshold.")

if barstate.islast and not trialOk
    runtime.error("FX TITAN PRO TRIAL vypršel (60 dní od 20. 8. 2026). Pro plnou verzi kontaktujte autora.")
