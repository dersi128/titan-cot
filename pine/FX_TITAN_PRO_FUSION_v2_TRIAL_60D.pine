//@version=6
indicator("FX TITAN PRO • FUSION v2 TRIAL 60D", shorttitle="TITAN TRIAL", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

import TradingView/LibraryCOT/2

// ===========================================================

// =====================================================================
// TITAN PRO FUSION v2 — STRUCTURE TREND  •  TRIAL 60 DNÍ
// Moduly: S/D CORE v2, COT, Location, Seasonality, Fusion panel.
// Zony: 1:1 logika TITAN S/D CORE v2 (standalone) — IN/OUT TOP, PREF pri prvnim doteku.
// Trend: struktura (HH/HL/LL/LH) + EMA potvrzeni + HTF bias (TITAN STRUCTURE TREND).
// Location swing: auto M=25, 2W=125, W=75, 3D=100, 2D=125, 1D=150 (+ manual ostatni).
//
// TRIAL: při nové kopii změň TRIAL_START i TRIAL_END (+60 dní).
// Kontroluje se reálný čas (timenow), ne čas svíčky.
// =====================================================================

// =====================================================================
// 0) TRIAL 60 DNÍ
// =====================================================================
int TRIAL_START = timestamp("UTC", 2026, 8, 20, 0, 0, 0)
int TRIAL_END   = timestamp("UTC", 2026, 10, 19, 0, 0, 0)
int trialMsLeft = TRIAL_END - timenow
bool trialOk    = timenow >= TRIAL_START and trialMsLeft >= 0
int trialDaysLeft = trialOk ? int(math.ceil(trialMsLeft / 86400000.0)) : 0

var table trialMark = table.new(position.bottom_center, 1, 1, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.rgb(55, 62, 82), frame_width=1, frame_color=color.rgb(55, 62, 82))
if barstate.islast
    color trialFg = not trialOk ? color.rgb(255, 82, 82) : trialDaysLeft <= 7 ? color.rgb(255, 167, 38) : color.rgb(160, 165, 180)
    string trialTxt = not trialOk ? "TITAN PRO • TRIAL VYPRŠEL  —  kontaktuj autora pro plnou verzi" : "TITAN PRO • TRIAL  " + str.tostring(trialDaysLeft) + " dní zbývá"
    table.cell(trialMark, 0, 0, trialTxt, text_color=trialFg, text_size=size.small, bgcolor=color.rgb(22, 26, 42))

// =====================================================================
// 1) S/D ZONY
// =====================================================================
grp_z = "S/D ZONY - CORE"
show_zones         = input.bool(true,  "Kreslit zony", group=grp_z)
del_broken         = input.bool(true,  "Smazat neplatne zony?", group=grp_z)
zone_max_mode      = input.string("Auto", "Max zon: rezim", options=["Auto", "Manual"], group=grp_z)
zone_max_manual    = input.int(4,      "Max zon na stranu (Manual)", minval=0, maxval=20, group=grp_z)

int max_zone_each = zone_max_mode == "Auto"
     ? (timeframe.isweekly ? 4 : (timeframe.ismonthly ? 3 : 4))
     : zone_max_manual
int max_demands_count  = max_zone_each
int max_supplies_count = max_zone_each

impulse_norm       = input.float(0.3,  "Normalni impuls (ATR)", step=0.1, group=grp_z)
impulse_str        = input.float(1.2,  "Silny impuls (ATR)", step=0.1, group=grp_z)
base_atr_mult      = input.float(0.25, "Base candle max body (ATR)", step=0.05, group=grp_z)
use_inout_label    = input.bool(true,  "TOP kvalita: IN/OUT label", group=grp_z)
mitigate_limit     = input.float(25.0, "Max vstup do preferovane zony (%)", group=grp_z)
sl_buffer          = input.float(0.15, "SL buffer (ATR)", step=0.05, group=grp_z)
extend_bars        = input.int(20,     "Prodlouzeni zony doprava", minval=1, group=grp_z)
use_wick_break     = input.bool(true,  "Impuls potvrdit wickem", group=grp_z)
in_min_mode        = input.string("Auto", "IN: pocet svicek", options=["Auto", "Manual"], group=grp_z)
in_min_manual      = input.int(2,      "IN: manual (jen pri Manual)", minval=1, maxval=5, group=grp_z)
in_body_atr_mult   = input.float(0.35, "IN: min. telo svicky (ATR)", step=0.05, group=grp_z)

int in_min_candles = in_min_mode == "Auto"
     ? ((timeframe.isweekly or timeframe.ismonthly) ? 1 : 2)
     : in_min_manual

