grp_season = "SEASONALITY"
season_mode            = input.string("Auto", "Rezim casovani", options=["Auto", "Daily", "Weekly"], group=grp_season)
season_useLogRet       = input.bool(true, "Pouzit log returns", group=grp_season)
season_scaleFactor     = input.float(100.0, "Meritko osy", minval=1.0, group=grp_season)
season_smoothLen       = input.int(5, "Vyhlazeni", minval=1, maxval=20, group=grp_season)
season_enableElection  = input.bool(true, "Pouzit volebni cyklus", group=grp_season)
season_filterMode      = input.string("Auto", "Filtr volebniho cyklu", options=["Auto", "Vsechny roky", "Election", "Post-Election", "Midterm", "Pre-Election"], group=grp_season)
season_yearsMode       = input.string("Poslednich N let", "Filtr let", options=["Vse", "Poslednich N let", "Rucni rozsah"], group=grp_season)
season_yearsN          = input.int(20, "N let", minval=2, maxval=50, group=grp_season)
season_yearFrom        = input.int(2010, "Od roku", minval=1900, maxval=2100, group=grp_season)
season_yearTo          = input.int(2026, "Do roku", minval=1900, maxval=2100, group=grp_season)
season_futureDays      = input.int(30, "Projekce dopredu (D)", minval=1, maxval=120, group=grp_season)
season_futureWeeks     = input.int(12, "Projekce dopredu (W)", minval=1, maxval=30, group=grp_season)
season_projectionFactor= input.float(0.70, "Jemnost projekce", minval=0.10, maxval=1.00, step=0.05, group=grp_season)
season_slopeLookback   = input.int(3, "Slope lookback", minval=1, maxval=10, group=grp_season)
season_slopeThreshold  = input.float(0.05, "Zakladni slope threshold", minval=0.0, step=0.01, group=grp_season)
