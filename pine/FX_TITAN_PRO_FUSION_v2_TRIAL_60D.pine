emaMidLen             = input.int(100, "Len", group=grp_trend, inline="e100", minval=1)
trendEma200On         = input.bool(true, "EMA 200", group=grp_trend, inline="e200")
emaTrendLen           = input.int(200, "Len", group=grp_trend, inline="e200", minval=1)
trendSlopeLookback    = input.int(5, "Sklon EMA 50/200 (bary)", minval=1, group=grp_trend)
trendScoreStrong      = input.int(70, "Prah silneho trendu", minval=1, maxval=100, group=grp_trend)
adxLen                = input.int(14, "ADX delka", minval=2, group=grp_trend)
rangeThreshold        = input.float(18.0, "ADX slabý trend", step=0.5, group=grp_trend)
strongTrendThreshold  = input.float(30.0, "ADX silný trend", step=0.5, group=grp_trend)
trendCompressPct      = input.float(1.5, "Komprese EMA 20-200 (%)", minval=0.1, step=0.1, group=grp_trend)
trendSepMaxPct        = input.float(4.0, "Max rozestup EMA pro skore (%)", minval=0.5, step=0.1, group=grp_trend)
trendBiasOn           = input.bool(true, "HTF bias", group=grp_trend)
trendBiasMode         = input.string("Auto", "Rezim bias TF", options=["Auto", "1D", "1W", "1M"], group=grp_trend)
trendHtfSwingMode     = input.string("Auto (bias)", "HTF swing delka", options=["Auto (bias)", "Stejná jako graf", "Manuál"], group=grp_trend)
trendHtfSwingManual   = input.int(10, "HTF swing (manual)", minval=2, maxval=100, group=grp_trend)
showTrendEma          = input.bool(false, "Kreslit EMA", group=grp_trend)
barColorEnabled       = input.bool(false, "Barvit svicky podle struktury", group=grp_trend)
useStrongBarColors    = input.bool(true, "Pouzit vyraznejsi barvy", group=grp_trend)
colorOnlyWithBias     = input.bool(false, "Barvit jen ve shode s HTF bias", group=grp_trend)

