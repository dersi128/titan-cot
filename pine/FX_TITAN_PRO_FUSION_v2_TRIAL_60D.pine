grp_loc_z = "LOCATION ↔ ZÓNY"
loc_zone_filter      = input.string("Vypnuto", "Filtr zón podle location", options=["Vypnuto", "Manual (klasika)", "Auto (trend)"], group=grp_loc_z,
     tooltip="Jen pro Fusion panel (výběr zóny). CORE zóny se vždy kreslí stejně jako standalone TITAN S/D CORE v2.")

// =====================================================================
